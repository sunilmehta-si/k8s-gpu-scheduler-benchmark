# Every component of the benchmark cluster, pinned in one place. The scripts and the cluster workflow read this file;
# a variable already set in the environment wins, for trying another release locally.
# kind and its node image fix the Kubernetes version (v1.37.0); the digest is from kind v0.33.0's release notes.
KIND_VERSION=v0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
KWOK_VERSION=v0.8.0
# Schedulers under test. KAI's Helm chart tags have no leading v.
KAI_VERSION=0.18.6
KUEUE_VERSION=v0.20.3
VOLCANO_VERSION=v1.16.0
